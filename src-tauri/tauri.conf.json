{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nova",
  "version": "0.1.0",
  "identifier": "com.kiza2.nova",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && node scripts/prepare-connector.mjs",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost nova-remote: http://nova-remote.localhost; media-src 'self' asset: http://asset.localhost nova-remote: http://nova-remote.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost nova-remote: http://nova-remote.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nova-connector"
    ]
  }
}
